# =============================================================================
# NEXUS V12.4 "COGNITIVE BOOST" Configuration
# =============================================================================
# Copy this file to .env and customize.
# Version is managed in pyproject.toml/core.version (single source of truth).
# All NEXUS_FF_* flags control feature toggles via core.config.FeatureFlags.

# =============================================================================
# API KEYS (Required for SDK drivers, optional for CLI drivers)
# =============================================================================
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=AIza...
# GEMINI_API_KEY=AIza...            # Alias for GOOGLE_API_KEY
# DEEPSEEK_API_KEY=sk-...           # DeepSeek API key
# KIMI_API_KEY=sk-...               # Moonshot AI Kimi: Thinking + Turbo at platform.moonshot.ai
# OPENAI_API_KEY=sk-proj-...
# MINIMAX_API_KEY=...               # MiniMax OpenAI-compatible endpoint

# =============================================================================
# DRIVER MODE
# =============================================================================
# auto = SDK when API key available, else CLI subprocess
# sdk  = Force SDK drivers (requires API keys)
# cli  = Force CLI subprocess drivers
NEXUS_DRIVER_MODE=auto

# =============================================================================
# FEATURE FLAGS (NEXUS_FF_<NAME>=true|false)
# =============================================================================

# --- RAG Pipeline ---
# NEXUS_FF_RAG_DATAMARKING=true         # Spotlighter datamarking on RAG results (OWASP LLM01 defense)
# NEXUS_FF_RAG_HYBRID_BACKEND=true      # Enable Dense+BM25 hybrid retrieval
# NEXUS_FF_RAG_DENSE_BACKEND=true       # Enable dense (semantic) backend

# --- Security ---
# NEXUS_FF_SANDBOX_ENABLED=true         # OS-level code sandbox (Docker) enabled by default
# NEXUS_FF_HOST_EXECUTION_ALLOWED=false # Allow validated host execution only for local development
# NEXUS_FF_KERNEL_FAIL_CLOSED=true      # Legacy KERNEL compatibility guard for internal-only paths

# --- Execution ---
# NEXUS_FF_HEADLESS_MODE=false          # Deterministic JSON output, no TTY
# NEXUS_FF_STREAMING_ENABLED=true       # Real-time token streaming

# --- Observability ---
# NEXUS_FF_OTEL_ENABLED=false           # OpenTelemetry export (Epic 4.3)
# NEXUS_FF_TELEMETRY_JSONL=true         # Legacy JSONL telemetry

# OpenTelemetry Configuration (Epic 4.3)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317  # OTel Collector gRPC endpoint
# OTEL_SERVICE_NAME=nexus-backend                     # Service identifier
# OTEL_SERVICE_VERSION=12.4.0                         # Service version
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development
# OTEL_LOG_LEVEL=info                                 # OTel internal logging
# NEXUS_ENV=development                               # Deployment environment (dev/staging/prod)

# --- Evolution ---
# NEXUS_FF_EVOLUTION_LLM_JUDGE=false    # LLM-as-judge for mutations (deprecated)
# NEXUS_FF_EVOLUTION_DETERMINISTIC=true # Deterministic fitness (AST+pytest only)

# --- Experimental ---
# NEXUS_FF_RUST_ACCELERATION=false      # Use Rust native extensions if compiled
# NEXUS_FF_SLM_TRIAGE=false             # Route trivial tasks to local SLM

# =============================================================================
# WORKSPACE & PATHS
# =============================================================================
WORKSPACE_PATH=./workspace
NEXUS_ROOT=.
LOG_LEVEL=INFO

# CLI paths (only needed for CLI driver mode)
GEMINI_CLI_PATH=gemini
CLAUDE_CLI_PATH=claude

# Model defaults (synchronized with core/provider_registry.json)
CLAUDE_OPUS_MODEL=claude-opus-4-6
CLAUDE_SONNET_MODEL=claude-sonnet-4-6
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
GEMINI_FLASH_MODEL=gemini-3-flash-preview
DEEPSEEK_MODEL=deepseek-chat
KIMI_MODEL=kimi-k2-thinking
OPENAI_MODEL=gpt-5.4
OPENAI_FAST_MODEL=gpt-5-mini
MINIMAX_MODEL=MiniMax-M2.5
MINIMAX_FAST_MODEL=MiniMax-M2.5-HighSpeed

# =============================================================================
# ORCHESTRATION
# =============================================================================
MAX_STALEMATE_COUNT=5
STAGNATION_SIMILARITY_THRESHOLD=0.8
TIMEOUT=600                             # FSM turn timeout (seconds)
CFL_TIMEOUT=60                          # CFL validation timeout (seconds)
COMPRESSION_THRESHOLD_TOKENS=100000     # Context compression trigger

# UI
UI_VERBOSE=False
CONSOLE_OUTPUT_LIMIT=5000               # Max chars streamed per response

# =============================================================================
# SWARM ENGINE
# =============================================================================
SWARM_ENABLED=True
SWARM_AUTO_ROUTE=True                   # Auto-route MODERATE+ tasks to Swarm
SWARM_NEGOTIATION=True
SWARM_NEGOTIATION_TURNS=4               # Max negotiation turns
SWARM_DEFAULT_MODE=ping_pong            # Default collaboration mode
SWARM_SKIP_TRIVIAL=True                 # Skip swarm for trivial tasks
SWARM_MAX_ROUNDS=6                      # Max execution rounds

# =============================================================================
# HIVE MIND (V8+ 7-Phase Pipeline)
# =============================================================================
HIVE_MIND_ENABLED=True
HIVE_MIND_MODERATE=True                 # Route MODERATE complexity to HiveMind
HIVE_MIND_BUDGET=50000                  # Token budget per task
HIVE_MIND_MAX_DEBATE=10                 # Max debate turns
HIVE_MIND_MIN_DEBATE=3                  # Min debate turns
HIVE_MIND_BREAKPOINTS=True              # Pause for approval at key decisions
HIVE_MIND_MAX_RETRIES=3                 # Retry attempts before escalation
HIVE_MIND_AGREEMENT_THRESHOLD=0.85      # Skip debate if agreement > threshold

# Fast path for trivial inputs (greetings, thanks)
FAST_PATH_ENABLED=True

# =============================================================================
# EVOLUTION
# =============================================================================
MAX_GEN_PER_DAY=10                      # Max evolution cycles per day
MIN_HOURS_BETWEEN_GEN=0.1              # Min hours between cycles (prod: 8)
MAX_CHILDREN_CONCURRENT=5               # Max children per cycle
MAX_CHILDREN_STABLE=10                  # Max total children
STABLE_MODE_THRESHOLD=5                 # Threshold for stable mode

# Evaluation timeline
MIN_EVAL_HOURS=24                       # Minimum evaluation period
RECOMMENDED_EVAL_HOURS=48               # Recommended evaluation period
CRITICAL_REVIEW_HOURS=72                # Critical review period
REPL_TURNS_TRIGGER=50                   # REPL turns to trigger evolution

# Red Team
RED_TEAM_MANDATORY=False                # Enforce alignment validation on promotion
RED_TEAM_MIN_SCORE=0.60                 # Minimum alignment score
RED_TEAM_FAIL_THRESHOLD=2              # Max failures before blocking
REDTEAM_SPAWN_ENABLED=True              # Validate spawned agent prompts
REDTEAM_SPAWN_BLOCK=False               # Block on validation failure

# Auto-promotion (opt-in, default OFF)
AUTO_PROMOTION=False
AUTO_PROMOTE_PCT=3.0                    # Min improvement % for auto-promotion

# Benchmark
BENCHMARK_MODE=standard                 # standard | bootcamp
VALIDATION_TIER=4                       # 1=syntax, 2=smoke, 3=bench, 4=redteam
USE_TIERED_VALIDATION=True
BENCHMARK_WORKERS=4                     # Parallel benchmark workers
BENCHMARK_TIMEOUT=60                    # Per-benchmark timeout (seconds)
AGENT_METRICS=True                      # DyLAN agent scoring
AGENT_METRICS_WINDOW=100                # Metrics rolling window

# =============================================================================
# TELEMETRY & BUDGET
# =============================================================================
TELEMETRY_ENABLED=True
TELEMETRY_FILE=workspace/telemetry.jsonl
BUDGET_LIMIT_USD=50.0                   # Daily spending limit ($0 = disabled)
BUDGET_WARNING_PCT=0.80                 # Warning threshold (80%)
BUDGET_CRITICAL_PCT=0.90                # Critical threshold (90%)

# Response cache (SDK drivers only)
RESPONSE_CACHE_SIZE=500                 # Max cached responses (LRU eviction)
RESPONSE_CACHE_TTL=300                  # Cache TTL in seconds

# Routing policy: balanced | cost_optimized | quality_optimized
# V12.4: cost_optimized prefers lower-cost provider tiers configured in the router.
# Validate current provider pricing externally before making public cost claims.
ROUTING_POLICY=balanced

# =============================================================================
# MEMORY (RAG Backend)
# =============================================================================
# Options: auto (recommended) | dense | bm25 | tfidf
PROJECT_MEMORY_BACKEND=auto
PROJECT_MEMORY_MAX_CHUNKS=5000

# =============================================================================
# GEMINI SESSION PERSISTENCE
# =============================================================================
GEMINI_PERSISTENT_MODE=True             # Resume sessions for multi-turn
GEMINI_APPROVAL_MODE=yolo               # Approval mode for CLI
GEMINI_STREAM_JSON=True                 # JSON output mode
GEMINI_PERSISTENT_TIMEOUT=300           # Session timeout (seconds)
STREAMING_ENABLED=True                  # Real-time token streaming

# =============================================================================
# REDIS & MULTI-INSTANCE (V12.3 Scale-Out)
# =============================================================================
REDIS_URL=redis://localhost:6379
USE_REDIS_WORKFLOWS=True                # Redis for workflow registry
USE_REDIS_HIBERNATION=False             # Redis for hibernation state
WORKFLOW_TTL_HOURS=24                   # Completed workflow TTL

# =============================================================================
# NOTIFICATIONS (disabled by default, requires configuration)
# =============================================================================
# EMAIL_ENABLED=false
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# EMAIL_FROM=your-email@domain.com
# EMAIL_TO=your-email@domain.com
# NEXUS_EMAIL_PASSWORD=your_app_password
# DESKTOP_NOTIF=false
# WEBHOOK_URL=https://your-webhook-url

# =============================================================================
# SECURITY (Production)
# =============================================================================
# NEXUS_JWT_SECRET=<generate with: python -c "import secrets; print(secrets.token_hex(32))">
# NEXUS_CORS_ORIGINS=http://localhost:3000,https://your-domain.com
# NEXUS_ADMIN_PASSWORD=<change in production>
